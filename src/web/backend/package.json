{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local -r ts-node/register index.ts",
    "build": "tsc --outDir dist",
    "test": "node --test -r ts-node/register pdf.test.ts resolve-pdf.test.ts repository-sources.test.ts article-links.test.ts browser-proxy.test.ts openalex.test.ts figshare.test.ts",
    "test:browser": "RUN_BROWSER_TESTS=1 node --test -r ts-node/register browser-pdf.test.ts",
    "experiment:browser": "ts-node browser-experiment.ts",
    "experiment:openalex": "ts-node openalex-experiment.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^4.19.2",
    "ipaddr.js": "^2.5.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
